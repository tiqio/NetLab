table inet netlab_management {
  set trusted_ipv4 {
    type ipv4_addr
    flags interval
    elements = { 10.72.0.0/16 }
  }

  set management_tcp_ports {
    type inet_service
    flags interval
    elements = { 18082, 5900-5999, 20000-20999, 30000-39999 }
  }

  chain input {
    type filter hook input priority -10; policy accept;
    ct state established,related accept
    iifname "lo" accept
    ip saddr @trusted_ipv4 tcp dport @management_tcp_ports accept
    tcp dport @management_tcp_ports drop
  }
}
