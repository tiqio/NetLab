{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://netlab.local/contracts/compliance-ledger.schema.json",
  "title": "NetLab Constitution Compliance Ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "constitution_version", "release_conclusion", "generated_at", "findings", "exceptions"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "constitution_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "candidate_id": { "type": ["string", "null"] },
    "acceptance_run_id": { "type": ["string", "null"] },
    "release_conclusion": { "enum": ["ready", "not_ready"] },
    "generated_at": { "type": "string", "format": "date-time" },
    "findings": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/finding" }
    },
    "exceptions": {
      "type": "array",
      "items": { "$ref": "#/$defs/exception" }
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "principle", "statement", "severity", "status", "owner", "requirement_ids", "evidence_ids", "last_reviewed_at"],
      "properties": {
        "id": { "type": "string", "pattern": "^CONST-[A-Z0-9-]+$" },
        "principle": { "type": "string", "minLength": 1 },
        "statement": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["critical", "high", "medium", "low"] },
        "status": { "enum": ["open", "partial", "blocked", "verified", "accepted_exception", "stale", "expired"] },
        "owner": { "type": "string", "minLength": 1 },
        "requirement_ids": { "type": "array", "items": { "type": "string", "pattern": "^FR-[0-9]{3}$" }, "uniqueItems": true },
        "evidence_ids": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "exception_id": { "type": ["string", "null"] },
        "next_action": { "type": ["string", "null"] },
        "candidate_id": { "type": ["string", "null"] },
        "last_reviewed_at": { "type": "string", "format": "date-time" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "verified" } } },
          "then": { "properties": { "evidence_ids": { "minItems": 1 } } },
          "else": { "required": ["next_action"] }
        },
        {
          "if": { "properties": { "status": { "enum": ["accepted_exception", "expired"] } } },
          "then": { "required": ["exception_id"] }
        }
      ]
    },
    "exception": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "finding_id", "owner", "scope", "risk", "motivation", "status", "expiration_condition", "removal_task"],
      "properties": {
        "id": { "type": "string" },
        "finding_id": { "type": "string", "pattern": "^CONST-[A-Z0-9-]+$" },
        "owner": { "type": "string", "minLength": 1 },
        "scope": { "type": "string", "minLength": 1 },
        "risk": { "type": "string", "minLength": 1 },
        "motivation": { "type": "string", "minLength": 1 },
        "approved_by": { "type": ["string", "null"] },
        "approved_at": { "type": ["string", "null"], "format": "date-time" },
        "expiration_condition": { "type": "string", "minLength": 1 },
        "removal_task": { "type": "string", "minLength": 1 },
        "status": { "enum": ["proposed", "approved", "expired", "closed", "rejected"] }
      }
    }
  }
}
